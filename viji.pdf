settings.configure(
    DEBUG=True,
    SECRET_KEY=&quot;123&quot;,
    ROOT_URLCONF=_name_,
    ALLOWED_HOSTS=[&quot;*&quot;],
    MIDDLEWARE=[]
)

import django
django.setup()

from django.http import HttpResponse
from django.urls import path

books = []


def home(request):
    html = &quot;&quot;&quot;
    &lt;h1&gt;Book Management&lt;/h1&gt;

    &lt;form method=&quot;post&quot; action=&quot;/add/&quot;&gt;

    Book Name:
    &lt;input name=&quot;name&quot;&gt;&lt;br&gt;&lt;br&gt;

    Author:
    &lt;input name=&quot;author&quot;&gt;&lt;br&gt;&lt;br&gt;

    Price:
    &lt;input name=&quot;price&quot;&gt;&lt;br&gt;&lt;br&gt;

    &lt;button&gt;Add Book&lt;/button&gt;

    &lt;/form&gt;&lt;hr&gt;
    &quot;&quot;&quot;

    for i, b in enumerate(books):
        html += f&quot;&quot;&quot;
        &lt;h3&gt;{b[&#39;name&#39;]}&lt;/h3&gt;

        &lt;p&gt;Author: {b[&#39;author&#39;]}&lt;/p&gt;
        &lt;p&gt;Price: ₹{b[&#39;price&#39;]}&lt;/p&gt;

        &lt;a href=&quot;/edit/{i}/&quot;&gt;Edit&lt;/a&gt; |
        &lt;a href=&quot;/delete/{i}/&quot;&gt;Delete&lt;/a&gt;

        &lt;hr&gt;
        &quot;&quot;&quot;

    return HttpResponse(html)


def add(request):
    if request.method == &quot;POST&quot;:
        books.append({
            &quot;name&quot;: request.POST[&quot;name&quot;],
            &quot;author&quot;: request.POST[&quot;author&quot;],
            &quot;price&quot;: request.POST[&quot;price&quot;]
        })

    return home(request)


def edit(request, id):
    if request.method == &quot;POST&quot;:
        books[id][&quot;name&quot;] = request.POST[&quot;name&quot;]
        books[id][&quot;author&quot;] = request.POST[&quot;author&quot;]
        books[id][&quot;price&quot;] = request.POST[&quot;price&quot;]

        return home(request)

    b = books[id]

    return HttpResponse(f&quot;&quot;&quot;
    &lt;form method=&quot;post&quot;&gt;

    Book Name:
    &lt;input name=&quot;name&quot; value=&quot;{b[&#39;name&#39;]}&quot;&gt;&lt;br&gt;&lt;br&gt;

    Author:
    &lt;input name=&quot;author&quot; value=&quot;{b[&#39;author&#39;]}&quot;&gt;&lt;br&gt;&lt;br&gt;

    Price:
    &lt;input name=&quot;price&quot; value=&quot;{b[&#39;price&#39;]}&quot;&gt;&lt;br&gt;&lt;br&gt;

    &lt;button&gt;Update&lt;/button&gt;

    &lt;/form&gt;
    &quot;&quot;&quot;)


def delete(request, id):
    books.pop(id)
    return home(request)


